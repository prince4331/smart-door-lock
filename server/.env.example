PORT=8080

# --- Required secrets -------------------------------------------------------
# Both values below are mandatory. The server loads this file once, then
# validates the effective configuration, and refuses to listen — exiting with
# a non-zero status before any broker connection or network bind — if either
# is missing, empty, whitespace-only, or shorter than 16 characters.
# Values already in the process environment take precedence over this file.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASH_TOKEN=

# Separate credential required for POST /api/cam/upload (device-side upload).
# The dashboard token is NOT accepted on that route, and this token is not
# accepted on dashboard routes. CAM_TOKEN is accepted as the legacy name for
# the same value.
CAM_UPLOAD_TOKEN=

# --- MQTT -------------------------------------------------------------------
MQTT_BROKER=mqtt://localhost:1883
MQTT_CLIENT_ID=smartlock-server
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Persistence ------------------------------------------------------------
DB_PATH=./data.db

# Camera snapshots are written outside the public web root and are only served
# by the authenticated GET /api/cam/latest route. Defaults to ./data/cam.
#CAM_STORAGE_DIR=./data/cam

# --- Camera -----------------------------------------------------------------
# These must use https:// when set. Plain http:// is rejected at startup.
CAM_STREAM_URL=https://your-esp32-cam/stream
CAM_SNAPSHOT_URL=https://your-esp32-cam/capture

# --- Telegram ---------------------------------------------------------------
TG_BOT_TOKEN=
TG_CHAT_ID=

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Emergency escape hatch only. Disables the rate limiter. Has no effect unless
# NODE_ENV is "development" or "test"; in production the limiter always runs.
#DISABLE_RATE_LIMIT=1
