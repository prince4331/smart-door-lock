PORT=8080

# --- Required secrets -------------------------------------------------------
# DASH_TOKEN is the single shared dashboard administrator credential.
# Generate a unique value and keep it out of source control.
DASH_TOKEN=

# Required for AES-256-GCM encryption of backend-owned Telegram settings.
# Use at least 32 random bytes; never commit it or store it in lowdb.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=

# --- MQTT -------------------------------------------------------------------
# Use a deployment-specific broker and credentials. Do not commit production values.
MQTT_BROKER=mqtt://localhost:1883
MQTT_CLIENT_ID=smartlock-server
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Persistence ------------------------------------------------------------
DB_PATH=./data.db

# Camera JPEGs are stored outside the public web root and served only through
# the authenticated /api/cam/latest route.
#CAM_STORAGE_DIR=./data/cam

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Emergency escape hatch only. It is honoured in development/test and ignored
# in production, where the rate limiter always runs.
#DISABLE_RATE_LIMIT=1

# --- Telegram ---------------------------------------------------------------
# Bot token and chat ID are configured through the authenticated dashboard
# settings endpoints. The backend encrypts them with SETTINGS_ENCRYPTION_KEY.
# Do not place TG_BOT_TOKEN or TG_CHAT_ID in this file or in firmware.
