PORT=8080
MQTT_BROKER=mqtt://localhost:1883
MQTT_CLIENT_ID=smartlock-server
MQTT_USERNAME=
MQTT_PASSWORD=
DB_PATH=./data.db

# Camera upload token (optional)
CAM_TOKEN=change-me
CAM_STREAM_URL=http://your-esp32-cam/stream
CAM_SNAPSHOT_URL=http://your-esp32-cam/capture
TG_BOT_TOKEN=
TG_CHAT_ID=

# API Security (Required for production)
API_KEY=your-secret-api-key-min-32-characters

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
